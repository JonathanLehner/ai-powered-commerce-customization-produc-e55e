# Every variable the app reads. Copy to .env.local and fill in; never commit real values.

# ClawCorp platform services (text generation, the assistant's model, uploads)
CLAWCORP_API_KEY=
# Optional: the platform OpenAI deployment the chat assistant uses (needs tool calling). Defaults to gpt-5.6-sol.
ASSISTANT_MODEL=

# Auth.js
AUTH_SECRET=

# MongoDB
MONGODB_URI=
# Local development and the checks only; never set on the deployment (production uses "parcelith")
MONGODB_DB=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Custom domains (Cloudflare for SaaS)
CLOUDFLARE_SAAS_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_CNAME_TARGET=
CLOUDFLARE_WORKER_NAME=

# Transactional email (optional)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=
RESEND_API_KEY=
APP_ORIGIN=
SALES_INBOX=

# Scheduled jobs
CRON_SECRET=
