{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-powered-commerce-customization-produc-e55e",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    // ClawCorp Mail lives on the same clawcorp.ai zone; without this a fetch to
    // it skips that Worker's route and goes to the zone's origin instead.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "ai-powered-commerce-customization-produc-e55e.clawcorp.ai/*",
      "zone_name": "clawcorp.ai"
    }
  ]
}
